# Secrets — API keys live in .env, never committed
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Raw API response cache (resumable scripts; regenerable, can be large)
cache/

# API call logs
logs/

# data/ and results/ ARE committed: git moves them between the API and work laptops

# Notebooks / editors / OS
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Gated benchmarks (GPQA, HLE): their terms ask that questions not be republished,
# and this repo is public. Rebuild locally with 02-jevlet-personas/10_build_ladder.py.
02-jevlet-personas/data/ladder/gpqa.jsonl
02-jevlet-personas/data/ladder/hle.jsonl
